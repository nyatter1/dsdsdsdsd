rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Player presence for multiplayer game rooms
    match /games/{gameId}/players/{playerId} {
      allow read: if true;
      allow create: if request.resource.data.uid == playerId;
      allow update: if request.resource.data.uid == playerId;
      allow delete: if true;
    }

    // In-game multiplayer chat messages
    match /games/{gameId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Games data
    match /games/{gameId} {
      allow read: if true;
      allow write: if true;
    }

    // Friend requests
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }

    // User profiles & user friends subcollections
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{userId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
