rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow full access to users profiles, friends, following, followers
    match /users/{userId} {
      allow read, write: if true;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Friend requests
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }

    // Published games & studio projects
    match /published_games/{gameId} {
      allow read, write: if true;
    }
    match /games/{gameId} {
      allow read, write: if true;
    }
    match /games/{gameId}/{document=**} {
      allow read, write: if true;
    }

    // Published clothing items
    match /published_clothing/{clothingId} {
      allow read, write: if true;
    }

    // Catch-all for any other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
