rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Player presence for multiplayer game rooms
    match /games/{gameId}/players/{playerId} {
      // Anyone can read active players in a game room
      allow read: if true;

      // Users can only write their own player document (playerId matches document ID)
      allow create: if request.resource.data.uid == playerId;
      allow update: if request.resource.data.uid == playerId;
      allow delete: if true;
    }

    // Games data
    match /games/{gameId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
